# Copy this file to .env.local and fill in real values.
# While MONGODB_URI is empty or still contains <placeholders>, the site runs on the
# built-in content in lib/profile-data.js and the contact form reports "not connected".
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB="portfolio"

# Bearer token for scripts calling the admin APIs (at least 16 characters).
ADMIN_TOKEN=""

# Password for logging in at /admin/login (8+ characters).
ADMIN_PASSWORD=""

# Signs login cookies (32+ random characters).
SESSION_SECRET=""

